{
  "name": "cloudmusic",
  "version": "1.0.0",
  "description": "Music browser and streaming API for Cloudflare Workers/Pages",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/bundle.js && wrangler dev --port 8787",
    "build": "node scripts/bundle.js",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "pages:deploy": "wrangler pages deploy dist/pages --project-name cloudmusic"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260916.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.132.0"
  }
}
